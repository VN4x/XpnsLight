# Listen address (Tailscale interface IP recommended, or 0.0.0.0 with tailscale_only matcher)
XPNS_LISTEN=0.0.0.0
XPNS_HTTPS_PORT=18312

# PocketBase loopback upstream (never expose 8090 on the LAN)
XPNS_POCKETBASE_UPSTREAM=127.0.0.1:8090

# tls internal | tls <email> for ACME (if public DNS)
XPNS_TLS_MODE=internal
